# ─────────────────────────────────────────────────────────────
# .env.example — 키 문서화용 템플릿 (병합 정리: ASK-Seoul#54)
# 실제 값은 팀 병합본 .env.dev(개발) / .env.prod(운영) 사용 — 비공개 채널로 공유.
# 원하는 쪽을 .env 로 복사해서 구동 (docker-compose 는 .env 고정 참조).
# ─────────────────────────────────────────────────────────────

# Cloudflare account
CLOUDFLARE_ACCOUNT_ID=<your-account-id>
CLOUDFLARE_API_TOKEN=

# D1 서빙 export — 팀 공용 서빙 D1 식별자 (R2 계정과 분리, ASAC-DAG#491). 미설정 시 서빙 export 실패.
SERVING_CLOUDFLARE_ACCOUNT_ID=<serving-account-id>
SERVING_D1_DATABASE_ID=<serving-d1-database-id>

# R2/Data Catalog fixed names
R2_BUCKET_NAME=seoul
TRINO_ICEBERG_CATALOG=iceberg      # dev: iceberg_dev / prod: iceberg
SMOKE_SCHEMA=ops_smoke             # dev: dev_<github_id> / prod: ops_smoke (elt_smoke 전용)
DBT_TARGET=dev                     # the only target selector; prod preflight requires prod
R2_RAW_PREFIX=raw                  # 존 루트만(#60) — 도메인 이하(ops_smoke/sample_events)는 코드가 조립

# R2 S3-compatible access
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# R2 Data Catalog / Iceberg REST catalog
R2_DATA_CATALOG_TOKEN=<r2-api-token-value>
R2_DATA_CATALOG_URI=<catalog-uri>
R2_DATA_CATALOG_WAREHOUSE=<warehouse>

# Dev R2/Data Catalog / Iceberg REST catalog — .env.dev 전용 블록 (prod 파일 미포함)
R2_DEV_BUCKET_NAME=seoul-dev
TRINO_DEV_ICEBERG_CATALOG=iceberg_dev
DEV_SMOKE_SCHEMA=dev_<github_id>
R2_DEV_RAW_PREFIX=dev/<github_id>/raw   # 존 루트만(#60) — 하위는 코드가 조립
R2_DEV_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_DEV_ACCESS_KEY_ID=<dev-r2-access-key-id>
R2_DEV_SECRET_ACCESS_KEY=<dev-r2-secret-access-key>
R2_DEV_DATA_CATALOG_TOKEN=<dev-r2-api-token-value>
R2_DEV_DATA_CATALOG_URI=<dev-catalog-uri>
R2_DEV_DATA_CATALOG_WAREHOUSE=<dev-warehouse>

# Seoul transit ingestion (ASAC-DAG #369)
SEOUL_API_KEY_TRAN=<seoul-open-data-plaza-key>
PUBLIC_DATA_API_KEY=<data-go-kr-decoding-key>
# 선택 튜닝 키(SUBWAY_STATIONS · BUS_ROUTES · BUS_* 수집창/티어 · TRANSIT_LOADER_* 등)는
# 코드 기본값 사용 — 기본값·주의사항은 dags/domains/transit 참조.
# ⚠ 버스 수집창 변경 시 일 10,000콜 쿼터 초과 주의 — tests/test_bus_collect_window.py 가 게이트.

# Culture domain (KOPIS·KOBIS·공공데이터포털·서울열린데이터)
KOPIS_SERVICE_KEY=<kopis-service-key>
KOBIS_SERVICE_KEY=<kobis-service-key>
PUBLIC_DATA_API_KEY_CULT=<data-go-kr-culture-key>
SEOUL_API_KEY_CULT=<seoul-open-data-plaza-key>

# Population/Citydata domain
SEOUL_API_KEY_PPLT=<seoul-open-data-plaza-key>
NAVER_DATALAB_CLIENT_ID=<naver-datalab-client-id>
NAVER_DATALAB_CLIENT_SECRET=<naver-datalab-client-secret>

# Commerce domain
SEOUL_API_KEY_COMM=<seoul-open-data-plaza-key>

# Weather DAG: weather_vilage_fcst_bronze
KMA_SERVICE_KEY=<kma-service-key>
KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
ASK_SEOUL_SCHEMA=<ask-seoul-schema>   # dev 표준: weather_traffic_bronze
ASK_SEOUL_DEV_RAW_PREFIX=raw
ASK_SEOUL_KMA_PLACE_ID=seoul_station
ASK_SEOUL_KMA_NX=60
ASK_SEOUL_KMA_NY=127

# Traffic DAG: traffic_incident_bronze
SEOUL_API_KEY_TRIC=<seoul-open-data-plaza-key>
SEOUL_OPEN_API_BASE_URL=http://openapi.seoul.go.kr:8088/
SEOUL_ACC_INFO_START_INDEX=1
SEOUL_ACC_INFO_END_INDEX=1000

# Discord 알림 웹훅 — 도메인별 채널 우선, 없으면 DISCORD_WEBHOOK_URL 폴백
DISCORD_WEBHOOK_URL=<discord-webhook-url>
TRANSIT_DISCORD_WEBHOOK_URL=
CULTURE_DISCORD_WEBHOOK_URL=
POPULATION_DISCORD_WEBHOOK_URL=
CITYDATA_DISCORD_WEBHOOK_URL=
COMMERCE_DISCORD_WEBHOOK_URL=
WEATHER_DISCORD_WEBHOOK_URL=
TRAFFIC_DISCORD_WEBHOOK_URL=
ASK_SEOUL_DISCORD_WEBHOOK_URL=
DISCORD_ERROR_NOTIFY_OPTOUT=traffic,weather   # 에러 알림 제외 도메인 (콤마 구분)

# Optional Wrangler R2 SQL check
WRANGLER_R2_SQL_AUTH_TOKEN=

# Airflow local runtime
AIRFLOW_UID=<id-u-result>
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<generated-password>   # dev: admin / prod: 멘토 제공값
AIRFLOW_ADMIN_EMAIL=<your-email>
AIRFLOW_FERNET_KEY=<generated-fernet-key>
AIRFLOW_SECRET_KEY=<generated-secret-key>

# Prod release only: immutable image reference supplied by the release artifact.
# .env.prod must not define ASK_SEOUL_TARGET or any R2_DEV_* key.
ASK_SEOUL_AIRFLOW_IMAGE=ghcr.io/<org>/ask-seoul-airflow@sha256:<image-manifest-digest>

# Prod lineage control-plane. Keep these credentials separate from the Airflow metadata DB.
MARQUEZ_POSTGRES_USER=<generated-marquez-postgres-user>
MARQUEZ_POSTGRES_PASSWORD=<generated-marquez-postgres-password>
MARQUEZ_POSTGRES_DB=<generated-marquez-postgres-database>

# Airflow metadata DB
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<generated-postgres-password>
POSTGRES_DB=airflow

# Trino shared-VM memory/concurrency guardrails
TRINO_MEMORY_LIMIT=9g
TRINO_TASK_CONCURRENCY=2
TRINO_QUERY_MAX_MEMORY_PER_NODE=2GB
TRINO_MEMORY_HEAP_HEADROOM_PER_NODE=2GB
TRINO_QUERY_MAX_MEMORY=2GB
TRINO_QUERY_MAX_TOTAL_MEMORY=4GB

# ─────────────────────────────────────────────────────────────
# commerce 전용값 (dags/domains/commerce/.env.commerce 에서 이관, ASAC-DAG#544)
# commerce 카테고리만 사용. .env.commerce 가 ${...} 로 이 값들을 상속한다.
# generic 이름은 타 도메인 env 오염을 막으려 COMMERCE_ 접두로 네임스페이스했다.
# (SEOUL_API_KEY_COMM·COMMERCE_DISCORD_WEBHOOK_URL 은 위에 별도 존재)
# ─────────────────────────────────────────────────────────────
# 서울 OpenAPI 수집 튜닝
COMMERCE_SEOUL_PAGE_SIZE=1000
COMMERCE_SEOUL_MAX_PAGES=
COMMERCE_SEOUL_REQUEST_DELAY_SECONDS=0.2
# 스토리지 백엔드/레이어 (local=컨테이너 볼륨, r2=Cloudflare R2)
COMMERCE_STORAGE_BACKEND=local
COMMERCE_LOCAL_DATA_ROOT=/opt/airflow/data
COMMERCE_STORAGE_PREFIX=
COMMERCE_RAW_LAYER=raw/commerce
COMMERCE_SILVER_LAYER=silver/commerce
COMMERCE_SCHEMA_VERSION=v1
COMMERCE_R2_REGION=auto
# Iceberg bronze 적재 — commerce 는 prod 카탈로그(iceberg, seoul 웨어하우스). 공유 DBT_TARGET 무변경.
COMMERCE_SCHEMA=commerce
COMMERCE_DBT_TARGET=prod
COMMERCE_LOAD_LOOKBACK_DAYS=3
COMMERCE_ICEBERG_EXPIRE_DAYS=7
# 상태 레이어(ASK-Seoul#60 존 정리 — 가변 상태·지시 파일은 raw 밖 ops 존 / ASAC-DAG#552)
COMMERCE_MARKERS_LAYER=ops/control/state/commerce/markers
COMMERCE_BRONZE_STATE_LAYER=ops/control/state/commerce/bronze
COMMERCE_SILVER_STATE_LAYER=ops/control/state/commerce/silver
COMMERCE_SERVE_STATE_LAYER=ops/control/state/commerce/serve
COMMERCE_DIFF_TARGET_LAYER=ops/control/state/commerce/diff_target
COMMERCE_WATCHDOG_STATE_LAYER=ops/control/state/commerce/watchdog
# 처리로그 일단위 적재(#60 ops/logs 존 — commerce_ops_logship 이 도커 볼륨에서 이관·정리)
COMMERCE_LOGS_LAYER=ops/logs/commerce
# Juso(도로명주소) API — silver 지번 결측 보강. *_KEY 는 자동 마스킹 대상.
JUSO_CONFM_KEY=<juso-confm-key>
JUSO_REQUEST_DELAY_SECONDS=0.07
JUSO_MAX_ADDRESSES=
